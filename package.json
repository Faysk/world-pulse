{
  "name": "world-pulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "test:browser": "playwright test",
    "benchmark:spatial": "node --experimental-strip-types scripts/spatial-benchmark.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "@playwright/test": "1.64.0"
  },
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  }
}
